   eval "${shar_touch}") && \
  chmod 0644 'example_goto_4.hs'
if test $? -ne 0
then ${echo} "restore of example_goto_4.hs failed"
fi
  if ${md5check}
  then (
       ${MD5SUM} -c >/dev/null 2>&1 || ${echo} 'example_goto_4.hs': 'MD5 check failed'
       ) << \SHAR_EOF
969604e7e160e2da365115cb51521d4a  example_goto_4.hs
SHAR_EOF
  else
test `LC_ALL=C wc -c < 'example_goto_4.hs'` -ne 4315 && \
  ${echo} "restoration warning:  size of 'example_goto_4.hs' is not 4315"
  fi
fi
# ============= README.momo_hs.txt ==============
if test -f 'README.momo_hs.txt' && ${keep_file}; then
${echo} "x - SKIPPING README.momo_hs.txt (file already exists)"
else
${echo} "x - extracting README.momo_hs.txt (text)"
  sed 's/^X//' << 'SHAR_EOF' > 'README.momo_hs.txt' &&
X
