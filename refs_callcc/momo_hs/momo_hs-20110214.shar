{- DESCRIPTION
X
example_goto_2.hs - an example of continuation.
X
An example shows anti-intuitive behavior of callCC using "goto".
X
Th code reduces a big loop to a small loop.
X
-}
X
module Main where
import System
import Control.Monad.Cont
X
data While a b c = LoopEnd a b
X                 | LoopStart a b ((While a b c)->c)
X                 | Label1 a b ((While a b c)->c)
X                 | Label2 a b ((While a b c)->c)
X
data BigWhile a b c = BLoopEnd a b
X                    | BLoopStart a b ((Either (While a b c) 
X                                               (BigWhile a b c))->c)
X                    | BLabel1 a b ((Either (While a b c) 
X                                            (BigWhile a b c))->c)
X                    | BLabel2 a b ((Either (While a b c) 
X                                            (BigWhile a b c))->c)
X
looper input output
X  = (callCC $ \goto ->return (Right (BLoopStart input output goto)));
X
testloop input = (looper input "") >>= \z -> case z of
X  {
X    Left z -> case z of
X       {
X         LoopEnd input output -> case input of
X            {
X              [] -> return (output ++ " rlend ");
X              c : r -> return (output ++ c ++ " rlastnext ");
X              };
X         LoopStart input output goto -> case input of
X           {
X             [] -> goto (LoopEnd [] (output ++ " rlse "));
X             c : r -> goto (Label1 r (output ++ " rlsn " ++ c) goto);
X             };
X         Label1 input output goto -> case input of
X           {
X             [] -> goto (LoopEnd [] (output ++ " rl1e "));
X             c : r -> goto (Label2 r (output ++ " rl1n " ++ c) goto);
X             };
X         Label2 input output goto -> case input of
X           {
X             [] -> goto (LoopEnd [] (output ++ " rl2e "));
X             c : r -> goto (LoopStart r (output ++ " rl2n " ++ c) goto);
X             };
X         };
X    
X    Right z -> case z of
X      {
X        BLoopEnd input output -> case input of
X           {
X             [] -> return (output ++ " llend ");
X             c : r -> return (output ++ c ++ " llastnext ");
X             };
X        BLoopStart input output goto -> case input of
X          {
X            [] -> goto (Right (BLoopEnd [] (output ++ " llse ")));
X            c : r -> goto (Right (BLabel1 r (output ++ " llsn " ++ c) goto));
X            };
X        BLabel1 input output goto -> case input of
X          {
X            [] -> goto (Right (BLoopEnd [] (output ++ " ll1e ")));
X            c : r -> goto (Right (BLabel2 r (output ++ " ll1n " ++ c) goto));
X            };
X        BLabel2 input output goto -> case input of
X          {
X            [] -> goto (Right (BLoopEnd [] (output ++ " ll2e ")));
X            c : r -> goto (Left (LoopStart r (output ++ " ll2n " ++ c)
X                                 (\y -> goto (Left y))));
X            };
X        };
X    }
X
main = do runCont (testloop ["a", "b", "c", "d", "e"]) putStrLn
