{- Author:     JRF
X   Maintainer: JRF <http://jrf.cocolog-nifty.com/>
X   Time-stamp: <2011-02-14T07:12:02Z>
X   License:    Public Domain
-}
X
{- DESCRIPTION
X
example_goto_4.hs - an example of continuation.
X
This example is a more sophisticated version of "example_goto_3.hs"
which expresses uselessness of function-value of "goto" with a type variable.
X
-}
X
module Main where
import System
import Control.Monad.Cont
X
data While a b m c d = LoopEnd a b
X                       ((While a b m c d)->m (c, a -> b -> (c -> m d) -> m d))
X                     | LoopStart a b
X                       ((While a b m c d)->m (c, a -> b -> (c -> m d) -> m d))
X                     | LoopMain a b
X                       ((While a b m c d)->m (c, a -> b -> (c -> m d) -> m d))
X                     | Method1 a b (c -> m d)
X                       ((While a b m c d)->m (c, a -> b -> (c -> m d) -> m d))
X                     | Receive1 a b
X                       ((While a b m c d)->m (c, a -> b -> (c -> m d) -> m d))
X                     | Dummy
X
X
looper input output
X  = (callCC $ \goto ->return (LoopStart input output goto));
X
runserver input = (looper input "") >>= \z -> case z of
X  {
X    LoopEnd input output goto -> case input of
X       {
X         [] -> return (Left (output ++ " slend "), 
X                       (\x y r -> (goto (Method1 x y r goto)) 
X                                  >>= \(Right u, v) -> return u));  -- absurd
X         c : r -> return (Left (output ++ c ++ " slastnext "),
X                       (\x y r -> (goto (Method1 x y r goto)) 
X                                  >>= \(Right u, v) -> return u));  -- absurd
X       };
X    LoopStart input output goto -> case input of
X      {
X        [] -> goto (LoopEnd [] (output ++ " slse ") goto);
X        c : r -> goto (LoopStart r (output ++ " slsn " ++ c) goto);
X      };
X    
X    {- receive request form client. -}
X    Method1 input output ret goto -> case input of
X      {
X        [] -> goto (LoopEnd [] (output ++ " sm1e ") goto);
X        c : r -> (if (c == "stop") then
X                    {- Yes, it can go out, but where to go? -}
X                   (goto (LoopEnd r (output ++  " sm11e " ++ c) goto))
X                 else
X                    {- send result to client. -}
X                    (ret (Left (output ++ " sm1n " ++ c))) >>= (\y -> goto Dummy));
X      };
X  }
X
{- server...or, daemon -}
server = runserver [];
X
runclient input = (looper input "") >>= \z -> case z of
X  {
X    LoopEnd input output goto -> case input of
X       {
X         [] -> return (Left (output ++ " clend "), 
X                       (\x y r -> (goto (Method1 x y r goto)) 
X                                  >>= \(Right u, v) -> return u)); -- absurd
X         c : r -> return (Left (output ++ c ++ " clastnext "),
X                       (\x y r -> (goto (Method1 x y r goto)) 
X                                  >>= \(Right u, v) -> return u)); -- absurd
X       };
X    LoopStart input output goto -> 
X      {- save output from server. -}
X      server >>= (\(Left sout, service)
X                  -> goto (LoopMain input (sout ++ output) goto));
X    LoopMain input output goto -> case input of
X      {
X        [] -> goto (LoopEnd [] (output ++ " clme ") goto);
X        {- send [c] to server. -}
X        c : r -> server >>= (\(sout, service)
X                             -> (service [c] (output ++ " clmn " ++ c)
X                                 (\(Left y) -> ((goto (Receive1 r y goto))
X                                         >>= \(Right u, v) -> return u)))) -- absurd
X                 >>= (\y -> goto Dummy);
X      };
X    
X    {- receive response form server. -}
X    Receive1 input output goto -> case input of
X      {
X        [] -> goto (LoopEnd [] (output ++ " cr1e ") goto);
X        c : r -> goto (LoopMain r (output ++ " cr1n " ++ c) goto);
X      };
X  }
X
main = do runCont ((runclient ["a", "b", "c", "d", "e"])
X                   >>= \(Left u, v) -> return u) putStrLn
X
{- The code blow fails into infinite loop. -}
-- main = do runCont ((server >>= (\(c, v) ->
--                                if (c == " slse  slend ") then
--                                  (runclient ["a", "b", "stop", "c"])
--                                else
--                                  (runclient ["d", "e", "f"])))
--                    >>= \(Left u, v) -> return u) putStrLn
X
SHAR_EOF
