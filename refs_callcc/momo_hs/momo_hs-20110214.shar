{- DESCRIPTION
X
example_goto.hs - an example of continuation.
X
An example shows anti-intuitive behavior of callCC using "goto".
X
-}
X
module Main where
import System
import Control.Monad.Cont
X
data While a b c = LoopEnd a b
X                 | LoopStart a b ((While a b c)->c)
X                 | Label1 a b ((While a b c)->c)
X                 | Label2 a b ((While a b c)->c)
X
looper input output
X  = (callCC $ \goto ->return (LoopStart input output goto));
X
testloop input = (looper input "") >>= \z -> case z of
X  {
X    LoopEnd input output -> case input of
X       {
X         [] -> return (output ++ " lend ");
X         c : r -> return (output ++ c ++ " lastnext ");
X       };
X    LoopStart input output goto -> case input of
X      {
X        [] -> goto (LoopEnd [] (output ++ " lse "));
X        c : r -> goto (Label1 r (output ++ " lsn " ++ c) goto);
X      };
X    Label1 input output goto -> case input of
X      {
X        [] -> goto (LoopEnd [] (output ++ " l1e "));
X        c : r -> goto (Label2 r (output ++ " l1n " ++ c) goto);
X      };
X    Label2 input output goto -> case input of
X      {
X        [] -> goto (LoopEnd [] (output ++ " l2e "));
X        c : r -> goto (LoopStart r (output ++ " l2n " ++ c) goto);
X      };
X  }
X
main = do runCont (testloop ["a", "b", "c", "d"]) putStrLn
